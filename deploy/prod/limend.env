# The core's settings at Latere. Every LIMEN_* variable limend reads is in
# docs/running.md. The issuer, the audience and the
# trusted CAs are the Deployment's own env entries; nothing here is a secret,
# and the authorizer's bearer is a file of the Secret limend-authorizer.
#
# The ledger is a directory on the volume `ledger`, which one process holds
# under a lock: one replica, rolled by Recreate.
LIMEN_ADDR=:7720
LIMEN_DATA_DIR=/var/lib/limen
# The public route: ingress.yaml forwards api.latere.ai/v1/oversight
# unchanged, and limend serves every route under this prefix as well as
# under /v1, where toposd calls it inside the cluster.
LIMEN_BASE_PATH=/v1/oversight
# Every request is decided by platformd's Limen decider on its internal TLS
# listener; the bearer is the file the Secret
# limend-authorizer is mounted as. The decider lets topos-service's own
# token predict, decide and answer for every person, as toposd does for
# each hosted session; lets a person read, answer, choose the profile of
# and forget their own records, and nothing else; and lets platformd's own
# service forget a closed account's records. LIMEN_ADMINS, the owner
# policy's admins, is not set: limend refuses it beside an authorization
# endpoint.
LIMEN_AUTHORIZER_URL=https://platformd-internal.latere.svc.cluster.local/internal/limen/authorize
LIMEN_AUTHORIZER_TOKEN_FILE=/var/run/limend-authorizer/token
